# Set once the production domain is confirmed. Leave empty until then:
# canonical URL and Open Graph URL are only emitted when this is set.
NEXT_PUBLIC_SITE_URL=

# Where contact form messages are POSTed as JSON:
#   { receivedAt, topic, name, email, message }
# Server-only: never prefix with NEXT_PUBLIC. Leave empty until a destination
# exists. While empty, development logs messages to the console and
# production shows an honest "sending isn't set up" error.
CONTACT_WEBHOOK_URL=

# Optional public links shown in the Contact section. Each one only appears
# when set. Social links must start with https://. Nothing is shown by default.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_GITHUB_URL=
NEXT_PUBLIC_LINKEDIN_URL=
